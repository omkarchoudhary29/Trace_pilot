# TracePilot Configuration Template
# Copy this file to .env and provide your actual API key.

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Strictly 2 models: primary and fallback)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash

# Request Control & Timeout (bounded between 1s and 300s)
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# API Retry Policy (bounded between 0 and 5 retries; base delay 0.1s to 30.0s)
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY=1.0

